/*
  Keyestudio 4WD BT Car V2.0 (KS0559, driver DRV8833)
  Robot controlat cu telecomanda IR  -  biblioteca IRremote 4.x   (v7)

  TELECOMANDA
    Sus / Jos / Stanga / Dreapta : robotul merge DOAR cat tii butonul apasat
    OK                           : stop (o singura apasare) + iese din orice mod
    1  PAZA (A)    : tu conduci. Daca mergi inainte si apare ceva la <= 15 cm,
                     robotul se opreste, da putin in spate si NU te mai lasa inainte
                     cat tii apasat; dai drumul la buton si il poti apasa din nou.
    2  URMARIRE MANA (M) : servo-ul scaneaza, gaseste mana, o urmareste si se
                     intoarce spre ea; apoi tine distanta (OK = iesire)
    3  URMARIRE LINIE (L) : urmareste linia neagra de pe jos (OK = iesire)
    0  cat tii apasat: servo-ul se misca stanga-dreapta; la eliberare revine la 90.
       Cat e apasat, robotul sta pe loc si modurile 2/3 sunt in pauza.
    4  cat tii apasat: se invarta pe loc spre STANGA foarte rapid + LED D9 clipeste rapid
    6  cat tii apasat: se invarta pe loc spre DREAPTA foarte rapid + LED D9 clipeste rapid
    *  treapta de viteza mai mare   (3 trepte; la maxim LED-ul D9 clipeste de 3 ori)
    #  treapta de viteza mai mica   (la minim LED-ul D9 clipeste de 3 ori)
    7, 8, 9 : rezervate pentru display (nefolosite deocamdata)

  DISPLAY: fata mare mereu in centru; in coltul din stanga litera modului: A, M sau L.

  La pornire robotul testeaza senzorul de distanta si scrie rezultatul in
  Serial Monitor (9600 baud). Daca Trig si Echo sunt inversate, le detecteaza singur.
*/

#include <IRremote.hpp>
#include <Servo.h>

// ===================== PINI =====================
#define IR_PIN      3     // receptor IR (integrat pe shield)
#define LED_PIN     9     // LED extern
#define SCL_Pin     A5    // matrice LED
#define SDA_Pin     A4
#define SERVO_PIN   A3
#define TRIG_PIN    12    // ultrasunete (se pot inversa automat la pornire)
#define ECHO_PIN    13
#define LINE_L_PIN  11    // senzori linie (1 = linie neagra)
#define LINE_M_PIN  7
#define LINE_R_PIN  8
#define LEFT_CTRL   2     // motoare stanga  (grup B)
#define LEFT_PWM    5
#define RIGHT_CTRL  4     // motoare dreapta (grup A)
#define RIGHT_PWM   6

// ===================== BUTOANE (comanda NEC din IRremote 4.x) =====================
// Verifica-le in Serial Monitor (9600): linia "command: 0x.."
#define KEY_FRONT 0x46
#define KEY_BACK  0x15
#define KEY_LEFT  0x44
#define KEY_RIGHT 0x43
#define KEY_STOP  0x40    // OK
#define KEY_1     0x16
#define KEY_2     0x19
#define KEY_3     0x0D
#define KEY_4     0x0C
#define KEY_6     0x5E
#define KEY_0     0x52
#define KEY_STAR  0x42
#define KEY_HASH  0x4A

// ===================== SETARI (le poti modifica) =====================
// Cele 3 trepte de viteza (putere 0..255): mica, medie, mare. Porneste pe cea medie.
const int SPEED_LEVELS[3] = {110, 160, 220};

#define TURN_INNER_PCT   50   // la viraj, partea interioara merge inapoi cu atatea % din viteza
#define TURN_INNER_MIN   100  // ...dar nu mai putin de atat (sub ~100 motoarele "tremura")
#define LEFT_TRIM_PCT    100  // corectie viteza partea stanga  (ex. 110 daca e mai slaba)
#define RIGHT_TRIM_PCT   100  // corectie viteza partea dreapta (ex. 90 daca e mai puternica)
#define SPIN_POWER       255  // viteza rotirii pe loc (butoanele 4 si 6)
#define SPIN_BLINK_MS    70   // clipire LED la rotire (aprins/stins)

#define HOLD_TIMEOUT_MS  250  // cat asteapta dupa ultimul semnal IR inainte sa opreasca
#define PING_INTERVAL_MS 60   // pauza intre masuratori ultrasunete (min ~60 ms)

#define AVOID_STOP_CM       15  // distanta de oprire in modul paza
#define AVOID_BACK_CM       5   // cat se da inapoi dupa oprire (0 = doar se opreste)
#define AVOID_BACKOFF_MAX_MS 500 // siguranta: maxim cat merge inapoi

#define FOLLOW_BACK_CM  10    // mana mai aproape de atat -> da inapoi
#define FOLLOW_STOP_CM  20    // intre 10 si 20 -> sta
#define FOLLOW_MAX_CM   50    // intre 20 si 50 -> merge dupa mana; peste -> nu o "vede"

// --- Servo ---
#define SERVO_CENTER        90
#define SERVO_HIGH_IS_LEFT  1    // 1: unghiurile > 90 sunt in STANGA. Pune 0 daca se intoarce invers
#define SWEEP_MIN           30   // butonul 0: limitele miscarii stanga-dreapta
#define SWEEP_MAX           150
#define SWEEP_STEP          5    // grade pe pas
#define SWEEP_STEP_MS       20   // ms intre pasi

// --- Urmarirea manii cu servo ---
#define FOLLOW_SCAN_MIN     40   // zona in care cauta mana (grade)
#define FOLLOW_SCAN_MAX     140
#define FOLLOW_SEARCH_STEP  6    // pas la cautare
#define FOLLOW_TRACK_SPAN   10   // dupa gasire verifica la -10, 0, +10 grade
#define FOLLOW_ALIGN_DEG    12   // peste atat fata de centru, robotul se intoarce spre mana
#define FOLLOW_TURN_MS      120  // durata unui impuls de intoarcere
#define FOLLOW_TURN_DEG     10   // cat se estimeaza ca s-a intors dupa un impuls
#define FOLLOW_LOST_CYCLES  3    // cicluri fara mana dupa care reia cautarea

#define BLINK_HALF_MS   70    // clipire LED la limita de viteza (aprins/stins)
#define DEBUG_IR        1     // 1 = scrie in Serial Monitor codul fiecarui buton
#define DEBUG_DIST      1     // 1 = scrie distanta masurata (modurile 1 si 2)

// Daca litera/fata apar rasturnate pe display, schimba aici:
#define MATRIX_MIRROR_H 0     // 1 = oglindeste stanga-dreapta
#define MATRIX_FLIP_V   0     // 1 = oglindeste sus-jos

// ===================== MODURI / MISCARI =====================
#define MODE_MANUAL 0
#define MODE_AVOID  1
#define MODE_FOLLOW 2
#define MODE_LINE   3

#define MV_NONE   0
#define MV_FRONT  1
#define MV_BACK   2
#define MV_LEFT   3
#define MV_RIGHT  4
#define MV_SPIN_L 5
#define MV_SPIN_R 6

#define AV_IDLE    0
#define AV_BACKOFF 1

#define FS_SEARCH 0
#define FS_TRACK  1

// ===================== FATA + LITERE (bit0 = sus, un byte = o coloana) =====================
const uint8_t FACE[8]     = {0x3C, 0x42, 0xAD, 0xC1, 0xC1, 0xAD, 0x42, 0x3C};
const uint8_t LETTER_A[3] = {0x1E, 0x05, 0x1E};
const uint8_t LETTER_M[3] = {0x1F, 0x06, 0x1F};
const uint8_t LETTER_L[3] = {0x1F, 0x10, 0x10};

// ===================== STARE =====================
Servo servo_A3;

uint8_t  mode = MODE_MANUAL;
uint8_t  curMove = MV_NONE;      // ce comanda au acum motoarele
uint8_t  heldMove = MV_NONE;     // directia tinuta apasata
uint32_t lastSignalMs = 0;       // ultimul semnal IR primit pentru directia tinuta
uint8_t  speedLevel = 1;         // 0 / 1 / 2
int      speed = 160;

uint8_t  trigPin = TRIG_PIN;
uint8_t  echoPin = ECHO_PIN;

uint8_t  avState = AV_IDLE;
uint32_t avStart = 0;
uint32_t nextPingMs = 0;

uint8_t  blinkToggles = 0;
uint32_t blinkNextMs = 0;

// butonul 0 (miscare servo)
bool     sweepHeld = false;
uint32_t sweepSignalMs = 0;
uint32_t sweepNextMs = 0;
int      sweepAngle = SERVO_CENTER;
int8_t   sweepDir = 1;

// urmarire mana
uint8_t  fState = FS_SEARCH;
int      fAngle = SERVO_CENTER;  // unghiul comandat servo-ului
int8_t   fDir = 1;               // sensul cautarii
int      fLock = SERVO_CENTER;   // unghiul la care e mana
uint8_t  fIdx = 0;               // care dintre cele 3 pozitii se masoara
int      fReadD[3] = {0, 0, 0};  // distantele din ciclul curent (0 = nimic)
int      fReadA[3] = {0, 0, 0};  // unghiurile corespunzatoare
uint8_t  fLost = 0;
uint32_t fReadyMs = 0;           // cand a ajuns servo-ul si se poate citi
uint32_t fTurnEndMs = 0;

const int8_t TRACK_OFFSETS[3] = {-FOLLOW_TRACK_SPAN, 0, FOLLOW_TRACK_SPAN};

// ===================== SETUP / LOOP =====================
void setup() {
  Serial.begin(9600);

  pinMode(LEFT_CTRL, OUTPUT);
  pinMode(LEFT_PWM, OUTPUT);
  pinMode(RIGHT_CTRL, OUTPUT);
  pinMode(RIGHT_PWM, OUTPUT);
  speed = SPEED_LEVELS[speedLevel];
  drive(MV_NONE);                       // pornim sigur, cu motoarele oprite

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  pinMode(LINE_L_PIN, INPUT);
  pinMode(LINE_M_PIN, INPUT);
  pinMode(LINE_R_PIN, INPUT);
  setUltrasonicPins(TRIG_PIN, ECHO_PIN);

  servo_A3.attach(SERVO_PIN);           // senzorul de distanta priveste drept
  servo_A3.write(SERVO_CENTER);
  delay(300);

  IrReceiver.begin(IR_PIN, false);      // false = fara LED feedback (pin 13 e ECHO)

  pinMode(SCL_Pin, OUTPUT);
  pinMode(SDA_Pin, OUTPUT);
  show_face(MODE_MANUAL);

  checkUltrasonic();
  Serial.println(F("Robot pornit"));
}

void loop() {
  handleIR();
  updateHold();
  updateSweep();
  updateAuto();
  updateBlink();
}

// ===================== IR =====================
void handleIR() {
  if (!IrReceiver.decode()) return;

  if (IrReceiver.decodedIRData.protocol != UNKNOWN) {
    if (IrReceiver.decodedIRData.flags & IRDATA_FLAGS_IS_REPEAT) {
      // buton tinut apasat: reinnoim "permisiunea" de miscare
      uint32_t now = millis();
      if (heldMove != MV_NONE) lastSignalMs = now;
      if (sweepHeld) sweepSignalMs = now;
    } else {
      uint8_t cmd = IrReceiver.decodedIRData.command;
#if DEBUG_IR
      Serial.print(F("command: 0x"));
      Serial.println(cmd, HEX);
#endif
      onKey(cmd);
    }
  }
  IrReceiver.resume();
}

void onKey(uint8_t cmd) {
  if (cmd != KEY_0) stopSweep();         // orice alt buton opreste miscarea servo-ului
  switch (cmd) {
    case KEY_FRONT: startManual(MV_FRONT);  break;
    case KEY_BACK:  startManual(MV_BACK);   break;
    case KEY_LEFT:  startManual(MV_LEFT);   break;
    case KEY_RIGHT: startManual(MV_RIGHT);  break;
    case KEY_4:     startManual(MV_SPIN_L); break;
    case KEY_6:     startManual(MV_SPIN_R); break;
    case KEY_0:     startSweep();           break;
    case KEY_STOP:  stopAll();              break;
    case KEY_1:     startMode(MODE_AVOID);  break;
    case KEY_2:     startMode(MODE_FOLLOW); break;
    case KEY_3:     startMode(MODE_LINE);   break;
    case KEY_STAR:  changeSpeed(+1);        break;
    case KEY_HASH:  changeSpeed(-1);        break;
  }
}

void startManual(uint8_t m) {
  // din urmarire mana / linie, orice miscare preia comanda; modul paza ramane activ
  if (mode == MODE_FOLLOW || mode == MODE_LINE) setMode(MODE_MANUAL);
  if (mode == MODE_AVOID && avState == AV_BACKOFF) return;   // se retrage, ignoram tastele

  heldMove = m;
  lastSignalMs = millis();

  if (mode == MODE_AVOID && m == MV_FRONT) {
    int d = readDistanceCm();
    dbgDist(d);
    if (d > 0 && d <= AVOID_STOP_CM) {   // obstacol prea aproape: nu pornim inainte
      heldMove = MV_NONE;                // repetarile aceluiasi buton sunt ignorate
      drive(MV_NONE);
      return;
    }
    nextPingMs = millis() + PING_INTERVAL_MS;
  }
  drive(m);
}

void stopAll() {
  heldMove = MV_NONE;
  drive(MV_NONE);
  if (mode != MODE_MANUAL) setMode(MODE_MANUAL);
}

void startMode(uint8_t m) {
  heldMove = MV_NONE;
  drive(MV_NONE);                       // modurile nu pornesc singure motoarele aici
  nextPingMs = millis();                // prima masuratoare imediat
  setMode(m);
}

void setMode(uint8_t m) {
  mode = m;
  avState = AV_IDLE;
  if (m == MODE_FOLLOW)      followStart();
  else if (!sweepHeld)       servo_A3.write(SERVO_CENTER);   // senzorul priveste drept
  fAngle = (m == MODE_FOLLOW) ? fAngle : SERVO_CENTER;
  show_face(m);
}

// Oprire cand nu mai vine semnal IR (butonul a fost eliberat)
void updateHold() {
  if ((mode == MODE_MANUAL || mode == MODE_AVOID) && heldMove != MV_NONE &&
      (uint32_t)(millis() - lastSignalMs) > HOLD_TIMEOUT_MS) {
    heldMove = MV_NONE;
    drive(MV_NONE);
  }
}

// ===================== SERVO: butonul 0 =====================
void startSweep() {
  if (sweepHeld) return;
  heldMove = MV_NONE;
  drive(MV_NONE);                        // robotul sta, modurile automate sunt in pauza
  avState = AV_IDLE;
  sweepHeld = true;
  sweepSignalMs = millis();
  sweepNextMs = millis();
  sweepAngle = SERVO_CENTER;
  sweepDir = 1;
}

void stopSweep() {
  if (!sweepHeld) return;
  sweepHeld = false;
  servo_A3.write(SERVO_CENTER);          // revine la 90
  fAngle = SERVO_CENTER;
  if (mode == MODE_FOLLOW) followStart();   // reia cautarea de la capat
}

void updateSweep() {
  if (!sweepHeld) return;
  uint32_t now = millis();
  if ((uint32_t)(now - sweepSignalMs) > HOLD_TIMEOUT_MS) { stopSweep(); return; }
  if ((int32_t)(now - sweepNextMs) < 0) return;
  sweepAngle += sweepDir * SWEEP_STEP;
  if (sweepAngle >= SWEEP_MAX) { sweepAngle = SWEEP_MAX; sweepDir = -1; }
  if (sweepAngle <= SWEEP_MIN) { sweepAngle = SWEEP_MIN; sweepDir = 1; }
  servo_A3.write(sweepAngle);
  sweepNextMs = now + SWEEP_STEP_MS;
}

// ===================== VITEZA (3 trepte) =====================
void changeSpeed(int dir) {
  int nl = (int)speedLevel + dir;
  if (nl > 2) nl = 2;
  if (nl < 0) nl = 0;
  speedLevel = (uint8_t)nl;
  speed = SPEED_LEVELS[speedLevel];
  if (curMove != MV_NONE) drive(curMove);          // aplica imediat daca merge
  if ((dir > 0 && nl == 2) || (dir < 0 && nl == 0)) {
    startBlink();                                   // ai ajuns la limita
  }
  Serial.print(F("treapta viteza: "));
  Serial.println(speedLevel + 1);
}

void startBlink() {
  blinkToggles = 6;                                 // 3 clipiri = 6 schimbari
  blinkNextMs = millis();
}

// LED D9: clipeste rapid cat se invarta pe loc, altfel clipirile de la limita de viteza
void updateBlink() {
  static bool wasSpin = false;
  static bool spinLed = false;
  uint32_t now = millis();
  bool spin = (curMove == MV_SPIN_L || curMove == MV_SPIN_R);

  if (spin) {
    wasSpin = true;
    blinkToggles = 0;
    if ((int32_t)(now - blinkNextMs) >= 0) {
      spinLed = !spinLed;
      digitalWrite(LED_PIN, spinLed ? HIGH : LOW);
      blinkNextMs = now + SPIN_BLINK_MS;
    }
    return;
  }
  if (wasSpin) {                                    // s-a terminat rotirea
    wasSpin = false;
    spinLed = false;
    digitalWrite(LED_PIN, LOW);
  }

  if (blinkToggles == 0) return;
  if ((int32_t)(now - blinkNextMs) < 0) return;
  digitalWrite(LED_PIN, (blinkToggles % 2 == 0) ? HIGH : LOW);
  blinkToggles--;
  blinkNextMs = now + BLINK_HALF_MS;
}

// ===================== MODURI =====================
void updateAuto() {
  if (sweepHeld) return;                            // butonul 0 pune totul in pauza
  if (mode == MODE_LINE)   { runLine();   return; }
  if (mode == MODE_AVOID)  { runGuard();  return; }
  if (mode == MODE_FOLLOW) { runFollow(); return; }
}

// Modul 1 - paza: nu porneste singur; verifica doar cat mergi inainte.
void runGuard() {
  uint32_t now = millis();

  if (avState == AV_BACKOFF) {                       // retragere dupa oprire
    if ((int32_t)(now - nextPingMs) < 0) {
      if ((uint32_t)(now - avStart) >= AVOID_BACKOFF_MAX_MS) endBackoff();
      return;
    }
    int d = readDistanceCm();
    now = millis();
    nextPingMs = now + PING_INTERVAL_MS;
    dbgDist(d);
    if (d >= AVOID_STOP_CM + AVOID_BACK_CM ||
        (uint32_t)(now - avStart) >= AVOID_BACKOFF_MAX_MS) endBackoff();
    return;
  }

  if (curMove != MV_FRONT) return;                   // verificam doar la mers inainte
  if ((int32_t)(now - nextPingMs) < 0) return;
  int d = readDistanceCm();
  now = millis();
  nextPingMs = now + PING_INTERVAL_MS;
  dbgDist(d);

  if (d > 0 && d <= AVOID_STOP_CM) {
    heldMove = MV_NONE;                              // butonul tinut nu mai are efect
    if (AVOID_BACK_CM > 0) {
      avState = AV_BACKOFF;
      avStart = now;
      nextPingMs = now;
      drive(MV_BACK);
    } else {
      drive(MV_NONE);
    }
  }
}

void endBackoff() {
  drive(MV_NONE);
  avState = AV_IDLE;
}

// ---------- Modul 2 - urmarire mana cu servo ----------
int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

// Muta servo-ul si calculeaza cand ajunge (mai mult timp pentru salturi mari).
void servoGo(int a) {
  a = clampi(a, FOLLOW_SCAN_MIN, FOLLOW_SCAN_MAX);
  int delta = a > fAngle ? a - fAngle : fAngle - a;
  fAngle = a;
  servo_A3.write(a);
  fReadyMs = millis() + 50 + (uint32_t)delta * 3;
}

void followStart() {
  fState = FS_SEARCH;
  fDir = 1;
  fLost = 0;
  fIdx = 0;
  fAngle = SERVO_CENTER;
  servo_A3.write(SERVO_CENTER);
  fReadyMs = millis() + 250;                         // servo-ul poate veni de departe
  drive(MV_NONE);
}

void followDecide() {
  int best = 0;                                      // cea mai mica distanta din ciclu
  for (uint8_t i = 0; i < 3; i++) {
    if (fReadD[i] > 0 && (best == 0 || fReadD[i] < best)) best = fReadD[i];
  }
  if (best == 0) {                                   // nimic vazut in ciclul asta
    drive(MV_NONE);
    if (++fLost >= FOLLOW_LOST_CYCLES) {             // mana pierduta: reia cautarea
      fState = FS_SEARCH;
      fDir = (fAngle < SERVO_CENTER) ? 1 : -1;
      fLost = 0;
    }
    return;
  }
  fLost = 0;
  long sum = 0;                                      // centrul mainii = media unghiurilor
  int cnt = 0;                                       // la care se vede (cam aceeasi distanta)
  for (uint8_t i = 0; i < 3; i++) {
    if (fReadD[i] > 0 && fReadD[i] <= best + 4) { sum += fReadA[i]; cnt++; }
  }
  int d = best;
  fLock = clampi((int)(sum / cnt), FOLLOW_SCAN_MIN, FOLLOW_SCAN_MAX);

  int off = fLock - SERVO_CENTER;                    // >0: unghi mare
#if !SERVO_HIGH_IS_LEFT
  off = -off;
#endif
  // off > 0 = mana e in STANGA robotului
  if (off > FOLLOW_ALIGN_DEG || off < -FOLLOW_ALIGN_DEG) {
    drive(off > 0 ? MV_LEFT : MV_RIGHT);             // impuls scurt de intoarcere
    fTurnEndMs = millis() + FOLLOW_TURN_MS;
    // estimam ca ne-am apropiat de centru
    if (fLock > SERVO_CENTER) fLock = clampi(fLock - FOLLOW_TURN_DEG, SERVO_CENTER, FOLLOW_SCAN_MAX);
    else                      fLock = clampi(fLock + FOLLOW_TURN_DEG, FOLLOW_SCAN_MIN, SERVO_CENTER);
    return;
  }
  if (d <= FOLLOW_BACK_CM)      drive(MV_BACK);
  else if (d < FOLLOW_STOP_CM)  drive(MV_NONE);
  else if (d <= FOLLOW_MAX_CM)  drive(MV_FRONT);
  else                          drive(MV_NONE);
}

void runFollow() {
  uint32_t now = millis();
  if ((curMove == MV_LEFT || curMove == MV_RIGHT) &&
      (int32_t)(now - fTurnEndMs) >= 0) drive(MV_NONE);   // impuls de intoarcere terminat
  if ((int32_t)(now - fReadyMs) < 0) return;

  int d = readDistanceCm();                          // 0 = fara ecou / necunoscut
  dbgDist(d);
  bool hit = (d > 0 && d <= FOLLOW_MAX_CM);

  if (fState == FS_SEARCH) {
    if (curMove != MV_NONE) drive(MV_NONE);
    if (hit) {                                       // am gasit mana: trecem la urmarire
      fState = FS_TRACK;
      fLock = fAngle;
      fIdx = 0;
      fLost = 0;
      servoGo(fLock + TRACK_OFFSETS[0]);
      return;
    }
    int next = fAngle + fDir * FOLLOW_SEARCH_STEP;
    if (next >= FOLLOW_SCAN_MAX) { next = FOLLOW_SCAN_MAX; fDir = -1; }
    if (next <= FOLLOW_SCAN_MIN) { next = FOLLOW_SCAN_MIN; fDir = 1; }
    servoGo(next);
    return;
  }

  // FS_TRACK: masuram la -10, 0, +10 grade fata de ultimul unghi
  fReadD[fIdx] = hit ? d : 0;
  fReadA[fIdx] = fAngle;
  if (fIdx < 2) {
    fIdx++;
    servoGo(fLock + TRACK_OFFSETS[fIdx]);
    return;
  }
  followDecide();
  fIdx = 0;
  servoGo(fLock + TRACK_OFFSETS[0]);
}

// ---------- Modul 3 - urmarire linie ----------
void runLine() {
  bool l = digitalRead(LINE_L_PIN);
  bool m = digitalRead(LINE_M_PIN);
  bool r = digitalRead(LINE_R_PIN);
  uint8_t mv;
  if (l && !r)       mv = MV_LEFT;
  else if (!l && r)  mv = MV_RIGHT;
  else               mv = m ? MV_FRONT : MV_NONE;
  if (mv != curMove) drive(mv);
}

// ===================== ULTRASUNETE =====================
void setUltrasonicPins(uint8_t trig, uint8_t echo) {
  trigPin = trig;
  echoPin = echo;
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  digitalWrite(trigPin, LOW);
}

int readDistanceCm() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  unsigned long us = pulseIn(echoPin, HIGH, 25000UL);   // timeout ~4 m (fara blocare 1 s)
  return (int)(us / 58);
}

int countEchoes() {
  int ok = 0;
  for (uint8_t i = 0; i < 5; i++) {
    if (readDistanceCm() > 0) ok++;
    delay(40);
  }
  return ok;
}

// Test la pornire: scrie in Serial Monitor daca senzorul raspunde; daca nu,
// incearca Trig/Echo inversate si pastreaza varianta care merge.
void checkUltrasonic() {
  int ok = countEchoes();
  if (ok == 0) {
    setUltrasonicPins(ECHO_PIN, TRIG_PIN);
    int okSwapped = countEchoes();
    if (okSwapped == 0) {
      setUltrasonicPins(TRIG_PIN, ECHO_PIN);
      Serial.println(F("Ultrasunete: NU primesc ecou (verifica cablajul/senzorul)"));
      return;
    }
    Serial.println(F("Ultrasunete: OK, Trig/Echo erau inversate (corectat automat)"));
    return;
  }
  Serial.print(F("Ultrasunete: OK, distanta acum "));
  Serial.print(readDistanceCm());
  Serial.println(F(" cm"));
}

