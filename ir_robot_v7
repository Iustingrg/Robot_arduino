// ===================== MOTOARE =====================
// power > 0 inainte, < 0 inapoi, 0 stop (max 255).
// DRV8833: cu directia HIGH, PWM mic = viteza mare, deci PWM = 255 - power.
void setSide(uint8_t ctrlPin, uint8_t pwmPin, int power) {
  if (power > 0) {
    if (power > 255) power = 255;
    digitalWrite(ctrlPin, HIGH);
    analogWrite(pwmPin, 255 - power);
  } else if (power < 0) {
    power = -power;
    if (power > 255) power = 255;
    digitalWrite(ctrlPin, LOW);
    analogWrite(pwmPin, power);
  } else {
    digitalWrite(ctrlPin, LOW);                      // stop: directie LOW + PWM 0
    analogWrite(pwmPin, 0);
  }
}

void setLeft(int p)  { setSide(LEFT_CTRL,  LEFT_PWM,  (int)((long)p * LEFT_TRIM_PCT  / 100)); }
void setRight(int p) { setSide(RIGHT_CTRL, RIGHT_PWM, (int)((long)p * RIGHT_TRIM_PCT / 100)); }

// Rotile de pe aceeasi parte sunt legate in paralel pe shield, deci se comanda
// ca o singura parte. La viraj: partea exterioara inainte, cea interioara
// inapoi (TURN_INNER_PCT% din viteza, minim TURN_INNER_MIN).
// Rotire pe loc: o parte inainte, cealalta inapoi, amandoua la SPIN_POWER.
void drive(uint8_t m) {
  int s = speed;
  int inner = (s * TURN_INNER_PCT) / 100;
  if (inner < TURN_INNER_MIN) inner = TURN_INNER_MIN;
  if (inner > s) inner = s;
  curMove = m;
  switch (m) {
    case MV_FRONT:  setLeft(s);           setRight(s);           break;
    case MV_BACK:   setLeft(-s);          setRight(-s);          break;
    case MV_LEFT:   setLeft(-inner);      setRight(s);           break;
    case MV_RIGHT:  setLeft(s);           setRight(-inner);      break;
    case MV_SPIN_L: setLeft(-SPIN_POWER); setRight(SPIN_POWER);  break;
    case MV_SPIN_R: setLeft(SPIN_POWER);  setRight(-SPIN_POWER); break;
    default:        setLeft(0);           setRight(0);           break;
  }
}

// ===================== MATRICE LED =====================
// Fata mare in centru (coloanele 4..11) + litera modului in coltul din stanga.
void show_face(uint8_t m) {
  uint8_t frame[16];
  for (uint8_t i = 0; i < 16; i++) frame[i] = 0;
  for (uint8_t i = 0; i < 8; i++) frame[4 + i] = FACE[i];

  const uint8_t *g = 0;
  if (m == MODE_AVOID)       g = LETTER_A;
  else if (m == MODE_FOLLOW) g = LETTER_M;
  else if (m == MODE_LINE)   g = LETTER_L;
  if (g) for (uint8_t i = 0; i < 3; i++) frame[i] = g[i];

#if MATRIX_FLIP_V
  for (uint8_t i = 0; i < 16; i++) {
    uint8_t b = frame[i], r = 0;
    for (uint8_t k = 0; k < 8; k++) { r = (r << 1) | (b & 1); b >>= 1; }
    frame[i] = r;
  }
#endif
#if MATRIX_MIRROR_H
  for (uint8_t i = 0; i < 8; i++) {
    uint8_t t = frame[i]; frame[i] = frame[15 - i]; frame[15 - i] = t;
  }
#endif
  matrix_display(frame);
}

void matrix_display(const uint8_t *matrix_value) {
  IIC_start();
  IIC_send(0xc0);
  for (uint8_t i = 0; i < 16; i++) {
    IIC_send(matrix_value[i]);
  }
  IIC_end();
  IIC_start();
  IIC_send(0x8A);
  IIC_end();
}

void IIC_start() {
  digitalWrite(SDA_Pin, HIGH);
  digitalWrite(SCL_Pin, HIGH);
  delayMicroseconds(3);
  digitalWrite(SDA_Pin, LOW);
  delayMicroseconds(3);
  digitalWrite(SCL_Pin, LOW);
}

void IIC_end() {
  digitalWrite(SCL_Pin, LOW);
  digitalWrite(SDA_Pin, LOW);
  delayMicroseconds(3);
  digitalWrite(SCL_Pin, HIGH);
  delayMicroseconds(3);
  digitalWrite(SDA_Pin, HIGH);
  delayMicroseconds(3);
}

void IIC_send(unsigned char send_data) {
  for (byte mask = 0x01; mask != 0; mask <<= 1) {
    if (send_data & mask) {
      digitalWrite(SDA_Pin, HIGH);
    } else {
      digitalWrite(SDA_Pin, LOW);
    }
    delayMicroseconds(3);
    digitalWrite(SCL_Pin, HIGH);
    delayMicroseconds(3);
    digitalWrite(SCL_Pin, LOW);
  }
}
